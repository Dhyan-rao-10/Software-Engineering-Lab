@startuml
title Academic Elective Bidding & Allocation System - UML Use-Case Diagram
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor Student
actor "Academic Registrar" as Registrar
actor "Notification Service" as Notification

rectangle "Academic Elective Bidding & Allocation System" {
  usecase "Submit Elective Bids\nand Preferences" as Submit
  usecase "Validate Credits" as Credits
  usecase "Validate Prerequisites" as Prereq
  usecase "View Eligible Electives" as Eligible
  usecase "Run Elective Allocation" as Allocate
  usecase "Resolve Capacity and\nTimetable Conflicts" as Conflicts
  usecase "Configure Elective\nOfferings and Rules" as Configure
  usecase "Publish Allocation\nResults" as Publish
  usecase "Revise Draft\nPreferences" as Revise
  usecase "Notify Students" as Notify
}

Student --> Submit
Student --> Eligible
Student --> Revise
Student --> Publish
Registrar --> Configure
Registrar --> Allocate
Registrar --> Publish
Notification --> Notify

Submit .> Credits : <<include>>
Submit .> Prereq : <<include>>
Submit .> Eligible : <<include>>
Allocate .> Conflicts : <<include>>
Publish .> Notify : <<include>>
Revise .> Submit : <<extend>>

note right of Revise
Extension point:
draft requires correction
before final submission
end note
@enduml

